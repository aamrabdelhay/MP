# Neon, Supabase, or another PostgreSQL connection string.
# Prefer the provider's pooled/SSL connection string on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Change this immediately for any non-local deployment.
# The server falls back to 2030 only when this variable is not set.
ADMIN_PASSWORD=2030

# Generate a unique secret with: openssl rand -base64 32
# Required in production; used to sign the httpOnly admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
